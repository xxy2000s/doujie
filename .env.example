# Doujie local override examples.
# Do not put real secrets in this file.

# Optional Codex model override.
# CODEX_MODEL=

# New Doujie variables. These take precedence over YAML config.
DOUJIE_OUTPUT_TRANSPORT=card
DOUJIE_CODEX_WORKDIR=~/service/doujie
DOUJIE_CODEX_SANDBOX=danger-full-access
DOUJIE_CODEX_SKIP_GIT_REPO_CHECK=false
DOUJIE_CODEX_CONTROL_SESSION_DIR=~/.doujie/sessions

DOUJIE_FEISHU_BOT_MENTION_IDS=cli_your_bot_app_id,ou_your_bot_open_id
DOUJIE_FEISHU_BOT_MENTION_NAMES=飞书 CLI,豆姐

DOUJIE_DB_PATH=~/.doujie/data.db
